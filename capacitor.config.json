{
  "appId": "com.itihaskarsamay.fluidstudio",
  "appName": "Fluid Itihaskar",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "chatgpt.com",
      "*.chatgpt.com",
      "openai.com",
      "*.openai.com",
      "labs.google",
      "*.labs.google",
      "accounts.google.com",
      "*.google.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
